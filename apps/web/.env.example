# apps/api's base URL. Defaults to http://localhost:3000 in code if unset,
# so this file is only needed to point at something else.
VITE_API_URL=http://localhost:3000

# Google OAuth client id (Google Cloud Console → Credentials → OAuth client,
# type "Web application", Authorized JavaScript origins including this
# site's origin, Authorized redirect URIs left empty — this app uses Google
# Identity Services' JS callback, not a server-side redirect flow). If
# unset, the "Sign in with Google" button simply doesn't render — email/
# password auth still works standalone.
VITE_GOOGLE_CLIENT_ID=
