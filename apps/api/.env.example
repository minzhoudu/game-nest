PORT=3000

# Postgres connection
DATABASE_URL=postgresql://gamenest:gamenest@localhost:5432/gamenest

# Shared secret nodes must present when registering over the agent WebSocket
AGENT_REGISTRATION_SECRET=change-me

# Signs user auth tokens (email/password login) — change this to a long
# random string; anyone with it can forge a login for any user.
JWT_SECRET=change-me-too
JWT_EXPIRES_IN=7d
