// GameNest control-plane schema.
// Mirrors the shapes in packages/shared-types/src/entities.ts — keep the two
// in sync when either changes (the Prisma models are the source of truth for
// storage; shared-types is what the wire/UI layers actually use).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NodeKind {
  local
  cloud
}

enum ServerStatus {
  creating
  stopped
  starting
  running
  stopping
  error
  deleting
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  /// Nullable so an OAuth-only account (Google, etc. — planned, not built
  /// yet) never needs a fake password. Email/password is the only method
  /// today, so this is always set in practice for now.
  passwordHash String?
  createdAt DateTime @default(now())

  nodes   GameNode[]
  servers GameServer[]

  @@map("users")
}

/// A host capable of running game server containers — a PC or a cloud VM.
/// Named GameNode (not Node) to avoid colliding with Node.js's own types.
///
/// NOT persisted/queried yet — NodeRegistryService still tracks connected
/// nodes purely in memory (see PLANNER.md). This model is a preview of the
/// future per-node-ownership work; GameServer.nodeId below deliberately
/// does NOT reference this table yet, since there's nothing in it.
model GameNode {
  id        String    @id @default(uuid())
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])
  name      String
  kind      NodeKind
  lastSeenAt DateTime?
  createdAt DateTime  @default(now())

  @@map("nodes")
}

/// A supported game, defined as a Docker image + its configuration surface.
model GameTemplate {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  dockerImage  String
  /// PortMapping[]
  ports        Json
  /// EnvVarSchema[]
  envSchema    Json
  /// { containerPath: string; label: string }[]
  volumeMounts Json?
  createdAt    DateTime @default(now())

  servers GameServer[]

  @@map("game_templates")
}

model GameServer {
  id         String       @id @default(uuid())
  ownerId    String
  owner      User         @relation(fields: [ownerId], references: [id])
  /// The connected agent's self-generated node id (NodeRegistryService, in
  /// memory) — deliberately not an FK to GameNode, since that table isn't
  /// populated yet. Not validated at the DB level; ServersController checks
  /// the node is currently connected before creating a server.
  nodeId     String
  templateId String
  template   GameTemplate @relation(fields: [templateId], references: [id])
  name       String
  status     ServerStatus @default(creating)
  /// GameServerConfig — { env: Record<string, string> }
  config     Json
  createdAt  DateTime     @default(now())

  @@map("game_servers")
}
